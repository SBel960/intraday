# Vérifie chaque heure ; --if-due ne télécharge que si le dernier snapshot est assez ancien.
# Persistent : un passage manqué (PC éteint, WSL arrêté) est rattrapé au démarrage.
[Unit]
Description=qlab : vérification horaire du snapshot exchangeInfo

[Timer]
OnCalendar=hourly
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
